FLASK_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=5000
TIMEZONE_NAME=America/Sao_Paulo
SECRET_KEY=change-me-local-secret-key
MAX_CONTENT_LENGTH=52428800

STORAGE_ROOT=storage
COMPARE_STORAGE_FOLDER=compare
COMPARE_RECEIVED_FOLDER=received
COMPARE_PROCESSED_FOLDER=processed
COMPARE_TEMP_FOLDER=temp

ALLOWED_COMPARE_EXTENSIONS=pdf,docx,xlsx,pptx
IMPLEMENTED_COMPARE_EXTENSIONS=pdf,docx,xlsx,pptx

DEFAULT_COMPARE_RESPONSE_MODE=json_file
ALLOWED_COMPARE_RESPONSE_MODES=download_url,json,json_file

CLEANUP_FILE_MAX_AGE_HOURS=24
CLEANUP_INTERVAL_MINUTES=60

# Extract-text configuration
EXTRACT_TEXT_STORAGE_FOLDER=extract_text
EXTRACT_TEXT_RECEIVED_FOLDER=received
EXTRACT_TEXT_PROCESSED_FOLDER=processed
EXTRACT_TEXT_TEMP_FOLDER=temp
ALLOWED_EXTRACT_TEXT_EXTENSIONS=pdf,docx,pptx
DEFAULT_EXTRACT_TEXT_OUTPUT_FORMAT=docx
ALLOWED_EXTRACT_TEXT_OUTPUT_FORMATS=docx,txt,json